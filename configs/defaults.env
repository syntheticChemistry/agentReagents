# agentReagents shared defaults — sourced by all active scripts
REAGENTS_USER="${REAGENTS_USER:-ecoprimals}"
REAGENTS_DIR="${REAGENTS_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
LIBVIRT_IMAGES="${LIBVIRT_IMAGES:-/var/lib/libvirt/images}"
PRIMAL_PORT_RANGE_START="${PRIMAL_PORT_RANGE_START:-9100}"
PRIMAL_PORT_RANGE_END="${PRIMAL_PORT_RANGE_END:-9800}"
CLOUD_IMAGE_UBUNTU_2404="${CLOUD_IMAGE_UBUNTU_2404:-ubuntu-24.04-server-cloudimg-amd64.img}"
CLOUD_IMAGE_UBUNTU_2204="${CLOUD_IMAGE_UBUNTU_2204:-ubuntu-22.04-server-cloudimg-amd64.img}"
VM_USER="${VM_USER:-ecoprimals}"
VM_PASSWORD="${VM_PASSWORD:-ecoprimals123}"
